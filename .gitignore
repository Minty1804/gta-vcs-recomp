# --- Game files: NEVER commit. Users bring their own disc/ISO. ---
*.iso
*.ISO
*.bin
*.cue
*.chd
SLUS_*
SLES_*
SCUS_*
/gamefiles/
/disc/

# --- Generated from the user's own ELF: contains translated game code ---
generated/
*.gzf
build/analysis/
ghidra/project/
ghidra/export/

# --- Build outputs ---
build/
out/
.vs/
.vscode/
*.exe
*.pdb
*.ilk
*.exp
*.obj
__pycache__/

# the build folder chosen elsewhere (tools/build_dir.py): this machine only
.vcs-build-dir
/VCSLauncher
/VCSLauncher.app
/VCSLauncher.old

# mods (src/mods/modloader.cpp): the player's own, never committed - only the folder's README
/modloader/*
!/modloader/README.md
